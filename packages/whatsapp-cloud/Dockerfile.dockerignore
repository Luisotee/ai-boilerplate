# Build-context filter for packages/whatsapp-cloud/Dockerfile (BuildKit picks up
# <Dockerfile>.dockerignore next to the Dockerfile and uses it INSTEAD of the
# root .dockerignore, since the build context is the repo root).
#
# Allowlist: send only what the image build copies.
**
!pnpm-lock.yaml
!pnpm-workspace.yaml
!packages/whatsapp-cloud/package.json
!packages/whatsapp-cloud/tsconfig.json
!packages/whatsapp-cloud/src/

# Never send these, even if a rule above would re-include them
**/node_modules/
**/dist/
packages/whatsapp-cloud/tests/
packages/whatsapp-cloud/vitest.config.ts
**/*.test.ts
**/.env
**/.env.*
**/auth_info_baileys/
# Logfire local credentials (never bake a write token into an image)
**/.logfire/
